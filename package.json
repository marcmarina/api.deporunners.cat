{
  "name": "api.deporunners.cat",
  "version": "0.1.0",
  "private": true,
  "repository": "https://github.com/marcmarina/api.deporunners.cat",
  "license": "ISC",
  "author": "Marc Marina",
  "main": "dist/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "postinstall": "husky install",
    "lint": "turbo run lint",
    "services:start": "docker-compose -f docker-compose.yml up -d",
    "services:stop": "docker-compose -f docker-compose.yml down",
    "start": "turbo run start",
    "test": "turbo run test",
    "verify": "turbo run verify"
  },
  "devDependencies": {
    "@types/jest": "29.5.1",
    "eslint": "8.40.0",
    "husky": "8.0.3",
    "jest": "29.5.0",
    "lint-staged": "13.2.2",
    "nodemon": "2.0.22",
    "prettier": "2.8.8",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.2",
    "turbo": "^1.9.3",
    "typescript": "4.9.4",
    "vitest": "^0.33.0"
  }
}
