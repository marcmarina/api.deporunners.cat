{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**"],
      "outputs": ["dist/**"],
      "cache": true,
      "outputMode": "new-only"
    },
    "test": {
      "dependsOn": ["build", "^test"],
      "cache": true,
      "outputMode": "new-only"
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": true
    },
    "verify": {
      "dependsOn": ["build", "test", "lint"]
    }
  }
}
